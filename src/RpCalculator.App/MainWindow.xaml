<Window x:Class="RpCalculator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="今日人品间隔分析器"
        Width="960"
        Height="720"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI">
    <WindowChrome.WindowChrome>
        <!-- 无系统标题栏：CaptionHeight 覆盖标题栏区域用于拖拽，ResizeBorderThickness 保留边缘缩放。 -->
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（主题色跟随切换） -->
        <Border Grid.Row="0"
                Height="64"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="False">
                    <TextBlock Text="今日人品间隔分析器"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding ModeSubtitle}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button Content="🌗 主题"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource BaseButtonStyle}"
                            Padding="14,7"
                            Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#x2014;"
                            Click="MinimizeWindow_Click"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#x25A1;"
                            Click="MaximizeWindow_Click"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="最大化 / 还原"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#x2715;"
                            Click="CloseWindow_Click"
                            Style="{StaticResource CloseWindowButtonStyle}"
                            ToolTip="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体滚动区域 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16,16,16,0">
            <StackPanel>
                <!-- 输入卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="计算参数" Style="{StaticResource SectionTitleStyle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton Content="随机生成识别码"
                                         IsChecked="{Binding IsRandomSource, Mode=TwoWay}"
                                         GroupName="SourceMode"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,20,0" />
                            <RadioButton Content="从文件导入"
                                         IsChecked="{Binding IsFileSource, Mode=TwoWay}"
                                         GroupName="SourceMode"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="识别码数量（支持 1e10）" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="窗口天数" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding DaysText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="K 值（Top-K，1~1000）" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding KText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <StackPanel Width="260" Margin="0,0,20,0">
                                <TextBlock Text="起始日期" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1" />
                            </StackPanel>

                            <StackPanel Width="260">
                                <TextBlock Text="算法模式" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Modes}"
                                          SelectedItem="{Binding SelectedModeOption, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          Background="{DynamicResource InputBackgroundBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource InputBorderBrush}"
                                          BorderThickness="1" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 文件路径 -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding FilePanelVisibility}">
                            <TextBlock Text="识别码文件（每行一个）" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Content="浏览…"
                                        Margin="10,0,0,0"
                                        Command="{Binding BrowseFileCommand}"
                                        Style="{StaticResource BaseButtonStyle}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="开始计算"
                                    Command="{Binding StartCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="28,10"
                                    Margin="0,0,12,0" />
                            <Button Content="取消"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="24,10" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 进度卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="处理进度" Style="{StaticResource SectionTitleStyle}" />
                        <ProgressBar Style="{StaticResource ModernProgressBar}"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     Maximum="{Binding ProgressMaximum}"
                                     IsIndeterminate="{Binding IsIndeterminate}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ProcessedText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="14" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ElapsedText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="当前全局最佳" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,6" />
                        <TextBlock Text="{Binding CurrentBestText}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" />
                        <TextBlock Text="{Binding InvalidCountText}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 结果卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="分析结果" Style="{StaticResource SectionTitleStyle}" />
                            <Button Grid.Column="1"
                                    Content="复制结果"
                                    Command="{Binding CopyResultCommand}"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Margin="0,0,0,12" />
                        </Grid>

                        <TextBlock Text="候选识别码（Top-K）" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding TopResults}"
                                  SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                  Background="{DynamicResource InputBackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource InputBorderBrush}"
                                  BorderThickness="1"
                                  Padding="10,7"
                                  MaxDropDownHeight="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Margin="0,14,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="识别码（可选中复制）" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding ResultId, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="关键指标" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ResultMetricText}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="100分次数" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ResultHundredCountText}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="总耗时" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ElapsedText}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <TextBlock Text="首个 100 分日期" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ResultFirstDateText}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="100 分日期（可滚动）" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding HundredDates}"
                                 Style="{StaticResource DateListBoxStyle}"
                                 MaxHeight="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
