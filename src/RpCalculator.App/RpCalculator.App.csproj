<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RpCalculator.App</RootNamespace>
    <AssemblyName>RpCalculator.App</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!--
      声明目标 RID，使 `dotnet restore`（不带 -r）也会生成 net8.0-windows/win-x64 的
      assets target。否则 CI 里 restore 不带 RID、随后 publish/build 带 -r win-x64 时，
      会报 NETSDK1047（project.assets.json 没有 win-x64 target）。
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RpCalculator.Core\RpCalculator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.6" />
  </ItemGroup>

  <!-- 图标用于 EXE 资源（ApplicationIcon）。 -->
  <ItemGroup>
    <None Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    发布体积优化：与 WPF 版一致，自包含 + 压缩；WPF 不支持裁剪，WinForms + AntdUI
    理论上可裁剪但为稳妥仍保持 PublishTrimmed=false。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(DebugType)' == ''">embedded</DebugType>
  </PropertyGroup>

</Project>
