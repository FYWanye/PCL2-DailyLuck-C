  <!-- ============== 快捷方式：开始菜单 ============== -->
  <Fragment>
    <DirectoryRef Id="StartMenuAppFolder">
      <Component Id="StartMenuShortcut" Guid="{C74A9D98-E1A6-4DA7-844A-3160D74E6D38}">
        <Shortcut Id="StartMenuShortcutLink"
                  Name="今日人品间隔分析器"
                  Target="[AppSubFolder]RpCalculator.App.exe"
                  Icon="AppIcon"
                  WorkingDirectory="AppSubFolder" />
        <RemoveFolder Id="RemoveStartMenuFolder" Directory="StartMenuAppFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\RpCalculator\今日人品间隔分析器"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- ============== 快捷方式：桌面 ============== -->
  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{0AE36D6D-0D9F-42F4-BE65-D434D52B9D84}">
        <Shortcut Id="DesktopShortcutLink"
                  Name="今日人品间隔分析器"
                  Target="[AppSubFolder]RpCalculator.App.exe"
                  Icon="AppIcon"
                  WorkingDirectory="AppSubFolder" />
        <RegistryValue Root="HKCU"
                       Key="Software\RpCalculator\今日人品间隔分析器"
                       Name="desktop"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <!-- ============== 快捷方式 ComponentGroup ============== -->
  <Fragment>
    <ComponentGroup Id="Shortcuts">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </ComponentGroup>
  </Fragment>

  <!-- ============== 图标：多分辨率 ICO（路径相对 -b 绑定根） ============== -->
  <Fragment>
    <Icon Id="AppIcon" SourceFile="src\RpCalculator.App\Assets\app.ico" />
  </Fragment>

</Wix>
